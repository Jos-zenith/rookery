---
// Pill buttons, 48px tall for thumbs. One primary per screen.
// With no href, renders a quiet "not yet" state instead of a dead link.
import Icon from './Icon.astro';
import type { IconName } from '../lib/icons';

interface Props {
  href?: string;
  variant?: 'primary' | 'ghost';
  size?: 'm' | 's';
  external?: boolean;
  icon?: IconName;
  class?: string;
}

const { href, variant = 'primary', size = 'm', external = false, icon, class: className } = Astro.props;
const trailingIcon: IconName | undefined = icon ?? (external ? 'arrow-up-right' : undefined);
---

{href ? (
  <a
    class:list={['btn', variant, size, className]}
    href={href}
    target={external ? '_blank' : undefined}
    rel={external ? 'noopener' : undefined}
  >
    <slot />
    {trailingIcon && <Icon name={trailingIcon} size={18} stroke={2} />}
    {external && <span class="visually-hidden">(opens in a new tab)</span>}
  </a>
) : (
  <span class:list={['btn', 'pending', size, className]} aria-disabled="true">
    <slot name="pending">Coming soon</slot>
  </span>
)}

<style>
  .btn {
    font: 600 1rem/1 var(--f-body);
    display: inline-flex; align-items: center; justify-content: center; gap: 10px;
    min-height: var(--tap); padding: 14px 22px;
    border-radius: var(--r-pill);
    border: var(--line) solid var(--ink);
    text-decoration: none; white-space: nowrap;
    transition: transform 0.15s ease, background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }
  .btn.s { min-height: 40px; padding: 9px 16px; font-size: 0.94rem; }
  .primary { background: var(--ink); color: var(--paper); }
  .primary:hover { background: var(--sea); border-color: var(--sea); }
  .ghost { background: transparent; color: var(--ink); }
  .ghost:hover { background: var(--ice); }
  a.btn:active { transform: translateY(1px); }
  .pending {
    background: transparent; color: var(--ink-2);
    border: var(--line) dashed var(--pebble); cursor: default;
  }
</style>
