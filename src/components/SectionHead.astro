---
interface Props {
  eyebrow: string;
  title: string;
  id?: string;
}
const { eyebrow, title, id } = Astro.props;
---

<header class="sec-head">
  <p class="label">{eyebrow}</p>
  <h2 id={id}>{title}</h2>
</header>

<style>
  .sec-head { display: grid; gap: 6px; max-width: var(--col); margin-bottom: 22px; }
</style>
