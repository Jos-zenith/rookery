---
import Logo from './Logo.astro';
import { site } from '../data/site';

const social = [
  { label: 'Instagram', href: site.social.instagram },
  { label: 'LinkedIn', href: site.social.linkedin },
].filter((s) => s.href);
---

<footer class="site-footer">
  <div class="page inner">
    <div class="brand">
      <div class="logo"><Logo variant="full" /></div>
    </div>
    <ul class="links">
      <li><a href="/apply">Apply</a></li>
      <li><a href="/#pond">Bring a problem</a></li>
      <li><a href="/#team">Suggest a Guide</a></li>
      <li><a href="/#partners">Partner with us</a></li>
      {social.map((s) => <li><a href={s.href} target="_blank" rel="noopener">{s.label}</a></li>)}
      {site.contactEmail && <li><a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a></li>}
    </ul>
  </div>
</footer>

<style>
  .site-footer { background: var(--band); color: var(--on-band); margin-top: var(--footer-gap, 96px); }
  .site-footer .inner { border-top: 1px solid color-mix(in srgb, var(--on-band) 18%, transparent); }
  .inner {
    display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 32px;
    padding-block: 48px 56px;
  }
  .brand { display: grid; gap: 18px; }
  .logo { width: 180px; color: var(--on-band); }
  .links { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .links a { color: var(--on-band); }
</style>
