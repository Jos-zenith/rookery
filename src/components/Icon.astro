---
import { icons, type IconName } from '../lib/icons';

interface Props {
  name: IconName;
  size?: number;
  stroke?: number;
  label?: string;
  class?: string;
}

const { name, size = 24, stroke = 1.75, label, class: className } = Astro.props;
---

<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  set:html={icons[name]}
/>

<style>
  .icon { flex: none; }
</style>
