---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import Trail from '../components/Trail.astro';
import type { IconName } from '../lib/icons';
import WeekStrip from '../components/WeekStrip.astro';
import { site } from '../data/site';
import { week } from '../data/content';

const applyOpen = Boolean(site.applyFormUrl);

const steps: { icon: IconName; title: string; note: string }[] = [
  { icon: 'egg', title: 'Apply', note: 'a short form' },
  { icon: 'chat', title: 'Onboard', note: 'frame, interview, sketch' },
  { icon: 'huddle', title: 'Join a huddle', note: 'a team of 4–5' },
  { icon: 'pond', title: 'Pick a problem', note: 'from the Problem Pond' },
];

const asks: { icon: IconName; title: string }[] = [
  { icon: 'clock', title: `${site.batch.hoursPerWeek} hours a week` },
  { icon: 'huddle', title: 'Show up for your huddle' },
  { icon: 'chat', title: 'Monday check-in' },
];
---

<Base title="Apply" description={`Apply for The Rookery pilot: ${site.batch.size} penguins, ${site.batch.weeks} weeks, all online.`}>
  <section class="page apply">
    <div class="intro">
      <p class="label">Pilot · {site.batch.size} penguins · {site.batch.weeks} weeks</p>
      <h1>Come build with us.</h1>
      <p class="lede">No experience needed. Any college.</p>
      <div class="cta">
        {applyOpen ? (
          <Button href={site.applyFormUrl} external>Open the application</Button>
        ) : (
          <p class="closed"><Icon name="egg" size={24} stroke={1.6} /> Applications open soon.</p>
        )}
      </div>
    </div>

    <h2 class="label sub">What happens next</h2>
    <Trail stages={steps} />

    <h2 class="label sub">A normal week</h2>
    <WeekStrip days={week} />

    <h2 class="label sub">What we ask</h2>
    <ul class="asks">
      {asks.map((a) => <li><Icon name={a.icon} size={28} stroke={1.6} /><span>{a.title}</span></li>)}
    </ul>
  </section>
</Base>

<style>
  .apply { padding-block: 56px 0; }
  .intro { display: grid; gap: 14px; max-width: var(--col); }
  .lede { font-size: 1.25rem; color: var(--ink-2); }
  .cta { margin-top: 10px; }
  .closed {
    display: inline-flex; gap: 12px; align-items: center; font-weight: 600;
    padding: 14px 20px; border: 1.5px dashed var(--pebble); border-radius: var(--r-pill); color: var(--ink-2);
  }
  .sub { margin: 80px 0 32px; font-family: var(--f-label); font-weight: 400; }
  .asks {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: 20px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
  }
  .asks li { display: flex; gap: 14px; align-items: center; font-weight: 600; }
  .asks :global(.icon) { color: var(--sea); }
</style>
