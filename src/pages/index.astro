---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';
import Button from '../components/Button.astro';
import Scene from '../components/Scene.astro';
import Spine from '../components/Spine.astro';
import Stamps from '../components/Stamps.astro';
import ProblemCard from '../components/ProblemCard.astro';
import { site } from '../data/site';
import {
  different, colleges, stages, onboarding, outcomes, passportSample,
  levels, problems, team, guidePerks, partnerWays,
} from '../data/content';

const applyOpen = Boolean(site.applyFormUrl);
const applyLabel = applyOpen ? 'Apply' : 'Applications open soon';
const partnerHref = site.partnerFormUrl || (site.contactEmail ? `mailto:${site.contactEmail}` : undefined);
const ps = passportSample;
const tints = ['tint-blue', 'tint-peach', 'tint-mint', 'tint-blue'];
---

<Base>
  <!-- Hero -->
  <div class="wrap">
    <section class="lane hero" aria-labelledby="hero-title">
      <div class="hero-grid">
        <div class="hero-text">
          <p class="label">A student builder club · first batch forming</p>
          <h1 id="hero-title">
            <span>Start small.</span>
            <span class="swash">Keep moving.
              <svg viewBox="0 0 300 24" preserveAspectRatio="none" aria-hidden="true"><path d="M4 16c50-10 120-14 180-10s90 6 112 2" /></svg>
            </span>
          </h1>
          <p class="lede">Build something real for a real person. Walk away with proof.</p>
          <div class="ctas">
            <Button href="/apply" icon="arrow-right">{applyLabel}</Button>
            <a class="trail-link" href="#pond">Have a problem?</a>
          </div>
        </div>
        <div class="hero-art">
          <svg class="blob" viewBox="0 0 480 440" aria-hidden="true">
            <path d="M236 22c96-8 198 44 222 140s-28 196-120 238-224 38-286-36S6 212 48 132 140 30 236 22z" />
          </svg>
          <div class="hero-mark">
            <Logo variant="mark" filled drawTrail label="A line-drawn penguin walking away from its trail" />
          </div>
        </div>
      </div>
    </section>

    {colleges.length > 0 && (
      <div class="lane proof">
        <div class="lane-body">
          <p class="label">Penguins from</p>
          <ul>{colleges.map((c) => <li>{c}</li>)}</ul>
        </div>
      </div>
    )}
  </div>

  <div class="wrap">
    <Spine>
      <!-- What's different -->
      <section class="lane sec" aria-labelledby="different">
        <div class="rail"><span class="node" data-node></span></div>
        <div class="lane-body">
          <p class="label">What’s different</p>
          <h2 id="different">Real problems, small huddles</h2>
          <ul class="diff">
            {different.map((d, i) => (
              <li>
                <span class:list={['diff-icon', tints[i]]}><Icon name={d.icon} size={30} stroke={1.6} /></span>
                <b>{d.title}</b>
                <span class="muted">{d.note}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- Journey: on wide screens the trail crosses the page through the stages -->
      <section class="lane sec band" aria-labelledby="lifecycle">
        <div class="rail"><span class="node" data-node></span></div>
        <div class="lane-body journey-head">
          <div>
            <p class="label">The journey · {site.batch.weeks} weeks</p>
            <h2 id="lifecycle">Five stages, one trail</h2>
            <p class="thesis">We don’t teach tools in isolation. We solve real problems with whatever the problem demands.</p>
          </div>
          <div class="starts">
            <p class="label">Everyone starts with</p>
            <ul>
              {onboarding.map((o) => <li><Icon name={o.icon} size={22} stroke={1.6} /><span>{o.title}</span></li>)}
            </ul>
          </div>
        </div>
        <ol class="stages">
          {stages.map((s, i) => (
            <li class:list={{ last: i === stages.length - 1 }} style={`--i: ${i}`}>
              <span class="dot" data-node><Icon name={s.icon} size={28} stroke={1.6} /></span>
              <span class="stage-text"><span class="step">{String(i + 1).padStart(2, '0')}</span><b>{s.title}</b><span class="muted">{s.note}</span></span>
              {i === stages.length - 1 && <span class="tail" data-node aria-hidden="true"></span>}
            </li>
          ))}
        </ol>
      </section>

      <!-- What you walk away with: bento -->
      <section class="lane sec" aria-labelledby="outcomes">
        <div class="rail"><span class="node" data-node></span></div>
        <div class="lane-body">
          <p class="label">What you walk away with</p>
          <h2 id="outcomes">Proof, not certificates</h2>
          <div class="bento">
            <article class="passport sketch" aria-label="Example Rookery Passport">
              <div class="pp-head">
                <div>
                  <p class="label">Rookery Passport</p>
                  <h3>{ps.name}</h3>
                </div>
                <span class="example">Example</span>
              </div>
              <p class="pp-problem"><Icon name="pond" size={22} stroke={1.6} /> {ps.problem}</p>
              <div class="pp-stats">
                <div><strong>{ps.interviews}</strong><span>interviews</span></div>
                <div><strong>{ps.versions}</strong><span>versions</span></div>
                <div><strong>1</strong><span>real sponsor</span></div>
              </div>
              <ol class="pp-trail" aria-label={`Reached ${stages[ps.stage].title}`}>
                {stages.map((s, i) => (
                  <li class:list={{ done: i < ps.stage, now: i === ps.stage }}><span></span><small>{s.title}</small></li>
                ))}
              </ol>
              <Stamps levels={levels} earned={ps.level} small />
              <p class="pp-quote">“{ps.quote}” · {ps.sponsor}</p>
              <div class="pp-stamp"><Scene name="stamp" /></div>
            </article>
            {outcomes.map((o) => (
              <div class:list={['tile sketch soft', `tint-${o.tint}`]}>
                <Icon name={o.icon} size={34} stroke={1.5} />
                <b>{o.title}</b>
                <span class="muted">{o.note}</span>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Problem Pond -->
      <section class="lane sec" aria-labelledby="pond">
        <div class="rail"><span class="node" data-node></span></div>
        <div class="lane-body split">
          <div class="split-text">
            <p class="label">Problem Pond</p>
            <h2 id="pond">Every problem has a sponsor</h2>
            <p class="muted big">Shops, NGOs, clinics, professors. A real person who has the problem, and will try what you build.</p>
            <div class="ctas">
              <Button href={site.sponsorFormUrl || undefined} variant="ghost" external>
                Have a problem? Sponsor one
                <Fragment slot="pending">Sponsor form opens soon</Fragment>
              </Button>
            </div>
          </div>
          <div class="split-art"><Scene name="pond" label="A penguin looking into a pond as a drop falls in" /></div>
        </div>
        {problems.length > 0 && (
          <div class="lane-body cards">{problems.map((p) => <ProblemCard {...p} />)}</div>
        )}
      </section>

      <!-- Who runs it -->
      <section class="lane sec" aria-labelledby="team">
        <div class="rail"><span class="node" data-node></span></div>
        <div class="lane-body split flip">
          <div class="split-art"><Scene name="huddle" label="A huddle of four penguins" /></div>
          <div class="split-text">
            <p class="label">Who runs it</p>
            <h2 id="team">No boss. Just Keepers and Guides.</h2>
            <ul class="team">
              {team.map((t) => (
                <li>
                  <Icon name={t.icon} size={26} stroke={1.6} />
                  <span><b>{t.role}</b> <span class="who">{t.who}</span><br /><span class="muted">{t.does}</span></span>
                </li>
              ))}
            </ul>
            <p class="voice">“I’m one of the Keepers, and I’ll be in the huddles with you.”</p>
          </div>
        </div>
        <div class="lane-body guides sketch tint-mint">
          <h3>Know a future Guide?</h3>
          <ul class="perks">
            {guidePerks.map((g) => <li><Icon name={g.icon} size={24} stroke={1.6} /><span>{g.title}</span></li>)}
          </ul>
          <Button href={site.guideFormUrl || undefined} variant="ghost" size="s" external>
            Suggest a Guide
            <Fragment slot="pending">Guide form opens soon</Fragment>
          </Button>
        </div>
      </section>

      <!-- For partners -->
      <section class="lane sec" aria-labelledby="partners">
        <div class="rail"><span class="node" data-node></span></div>
        <div class="lane-body split">
          <div class="split-text">
            <p class="label">For partners and CSR</p>
            <h2 id="partners">Back a batch of builders</h2>
            <p class="muted big">Help students build for real people, and meet the builders early.</p>
            <div class="ctas">
              <Button href={partnerHref} variant="ghost" external={Boolean(site.partnerFormUrl)}>
                Partner with us
                <Fragment slot="pending">Partner form opens soon</Fragment>
              </Button>
            </div>
          </div>
          <ul class="ways">
            {partnerWays.map((w, i) => (
              <li class:list={['sketch soft', tints[i % 4]]}>
                <Icon name={w.icon} size={32} stroke={1.5} /><b>{w.title}</b>
              </li>
            ))}
          </ul>
        </div>
      </section>
    </Spine>
  </div>

  <!-- Closing: full-bleed sea band, the penguin heads out -->
  <section class="close" aria-labelledby="close">
    <div class="wrap">
      <div class="lane">
        <div class="lane-body split">
          <div class="split-text">
            <p class="label">One last thing</p>
            <h2 id="close">Come build with us.</h2>
            <p class="note">
              I don’t have all of this figured out. I’ll show up, I’ll be honest with you, and I’ll put my network to work
              for everyone who puts in the effort.
            </p>
            <p class="signature">— {site.founder.name}</p>
            <div class="ctas"><Button href="/apply" variant="light" icon="arrow-right">{applyLabel}</Button></div>
          </div>
          <div class="split-art"><Scene name="fledge" label="A penguin heading out to sea" /></div>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .wrap { max-width: var(--page); margin-inline: auto; padding-inline: var(--gutter); }
  /* every block sits beside the trail's lane, so text lines up down the page */
  .lane { display: grid; grid-template-columns: var(--rail) minmax(0, 1fr); column-gap: var(--rail-gap); }
  .lane-body { grid-column: 2; min-width: 0; }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px 20px; align-items: center; margin-top: 8px; }
  .trail-link { font-weight: 600; text-decoration: underline dashed 1.5px; text-underline-offset: 5px; }
  .trail-link:hover { text-decoration-style: solid; }
  h2 { font-size: clamp(2rem, 1.4rem + 2vw, 3rem); line-height: 1.08; }
  .big { font-size: 1.15rem; max-width: 34em; }

  /* hero */
  .hero { padding-block: 40px 0; }
  .hero-grid { grid-column: 2; display: grid; gap: 8px 48px; align-items: center; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 900px) { .hero-grid { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); } .hero { padding-block: 56px 24px; } }
  @media (max-width: 899px) { .hero-grid { grid-column: 1 / -1; } }
  .hero-text { display: grid; gap: 22px; }
  .hero h1 { font-size: var(--t-h1); font-weight: 700; line-height: 1.02; display: grid; }
  .swash { position: relative; color: var(--sea); width: max-content; max-width: 100%; }
  .swash svg { position: absolute; left: 0; right: 0; bottom: -0.16em; width: 100%; height: 0.3em; overflow: visible; }
  .swash path { fill: none; stroke: var(--beak); stroke-width: 6; stroke-linecap: round; vector-effect: non-scaling-stroke; }
  .lede { font-size: clamp(1.15rem, 1rem + 0.5vw, 1.4rem); color: var(--ink-2); max-width: 24em; }
  .hero-art { position: relative; width: 100%; max-width: 580px; justify-self: end; aspect-ratio: 480 / 440; }
  .blob { position: absolute; inset: 0; width: 100%; height: 100%; }
  .blob path { fill: var(--tint-blue); }
  .hero-mark { position: absolute; inset: 6% 4% 8% 2%; color: var(--ink); --logo-body: var(--paper); }
  @media (max-width: 899px) { .hero-art { max-width: 360px; order: -1; justify-self: start; } }

  .proof { margin-top: 40px; }
  .proof .lane-body { display: grid; gap: 10px; }
  .proof ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 28px; font-weight: 600; color: var(--ink-2); }

  /* sections */
  .sec { position: relative; padding-top: clamp(96px, 10vw, 150px); align-content: start; row-gap: 0; }
  .sec:first-child { padding-top: 88px; }
  .rail { grid-column: 1; grid-row: 1; display: grid; justify-items: center; align-content: start; }
  .node { position: relative; z-index: 1; width: 16px; height: 16px; border-radius: 50%; background: var(--paper); border: 2px solid var(--ink); margin-top: 10px; }
  .lane-body > h2, .split-text > h2, .journey-head h2 { margin-bottom: 18px; }
  .label + h2 { margin-top: 8px; }
  :global(.spine-wrap) { isolation: isolate; }
  :global(main) { overflow-x: clip; }

  /* full-bleed tinted band */
  .band { margin-top: clamp(80px, 8vw, 120px); padding-block: 88px 120px; }
  .band::before {
    content: ""; position: absolute; z-index: -1; top: 0; bottom: 0;
    left: calc(50% - 50vw); right: calc(50% - 50vw);
    background: var(--tint-blue);
  }
  .band .node, .band .dot { background: var(--tint-blue); }

  /* what's different */
  .diff { list-style: none; margin: 28px 0 0; padding: 0; display: grid; gap: 36px 32px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); }
  .diff li { display: grid; gap: 8px; align-content: start; }
  .diff-icon { width: 68px; height: 68px; border-radius: 50%; display: grid; place-items: center; background: var(--tint); margin-bottom: 8px; }
  .diff b, .stage-text b, .tile b, .ways b {
    font-family: var(--f-hand); font-variation-settings: var(--infm-head); font-weight: 600; font-size: 1.25rem; line-height: 1.25;
  }
  .diff .muted { font-size: 1rem; }

  /* journey */
  .journey-head { display: grid; gap: 20px 48px; grid-template-columns: minmax(0, 1fr); align-items: end; }
  @media (min-width: 960px) { .journey-head { grid-template-columns: minmax(0, 1fr) auto; } }
  .starts { display: grid; gap: 10px; }
  .starts ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .starts li { display: inline-flex; gap: 8px; align-items: center; font-weight: 600; font-size: 0.95rem; padding: 8px 14px; border-radius: var(--r-pill); background: var(--paper); }

  .stages { grid-column: 1 / -1; list-style: none; margin: 40px 0 0; padding: 0; display: grid; gap: 28px; }
  .stages li { display: grid; grid-template-columns: var(--rail) minmax(0, 1fr); column-gap: var(--rail-gap); align-items: center; }
  .dot {
    --d: 40px;
    position: relative; z-index: 1;
    width: var(--d); height: var(--d); border-radius: 50%; justify-self: center;
    display: grid; place-items: center; background: var(--paper); border: var(--line) solid var(--ink); color: var(--ink);
  }
  .dot :global(.icon) { width: 20px; height: 20px; }
  .stages .last .dot { background: var(--beak); border-color: var(--beak); color: var(--on-beak); }
  .stage-text { display: grid; }
  .tail { display: none; }
  .stage-text b { font-size: 1.45rem; }
  .step { font-family: var(--f-hand); font-size: 0.85rem; color: var(--sea); }
  @media (min-width: 1180px) {
    /* the stages step down across the page, so the trail walks through them */
    .stages { grid-column: 2; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 0 24px; margin-top: 56px; }
    .stages li { grid-template-columns: minmax(0, 1fr); justify-items: start; align-items: start; row-gap: 16px; padding-top: calc(var(--i) * 56px); }
    .dot { --d: 80px; justify-self: start; }
    .stages li { position: relative; }
    /* waypoint that walks the trail out around the last stage's words */
    .tail { display: block; position: absolute; width: 2px; height: 2px; left: calc(100% - 4px); top: calc(var(--i) * 56px + 80px + 130px); }
    .dot :global(.icon) { width: 34px; height: 34px; }
  }
  .thesis { margin-top: 4px; font-family: var(--f-hand); font-variation-settings: var(--infm-note); font-size: clamp(1.3rem, 1.05rem + 1vw, 1.9rem); line-height: 1.35; color: var(--sea); max-width: 34ch; }

  /* bento */
  .bento { margin-top: 28px; display: grid; gap: 16px; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 620px) { .bento { grid-template-columns: repeat(2, minmax(0, 1fr)); } .passport { grid-column: 1 / -1; } }
  @media (min-width: 1040px) { .bento { grid-template-columns: minmax(0, 1.35fr) repeat(2, minmax(0, 1fr)); } .passport { grid-column: 1; grid-row: span 2; } }
  .passport { padding: 28px; display: grid; gap: 18px; align-content: start; }
  .pp-head { display: flex; justify-content: space-between; align-items: start; gap: 12px; }
  .pp-head h3 { font-size: 1.8rem; }
  .example { font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-2); border: 1px solid var(--pebble); border-radius: 6px; padding: 2px 8px; }
  .pp-problem { display: flex; gap: 10px; align-items: center; font-weight: 600; }
  .pp-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; max-width: 420px; }
  .pp-stats div { display: grid; }
  .pp-stats strong { font-family: var(--f-hand); font-variation-settings: var(--infm-head); font-size: 2rem; line-height: 1.1; }
  .pp-stats span { font-size: 0.82rem; color: var(--ink-2); }
  .pp-trail { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); max-width: 460px; }
  .pp-trail li { display: grid; gap: 6px; justify-items: center; position: relative; }
  .pp-trail li + li::before { content: ""; position: absolute; top: 6px; right: calc(50% + 9px); width: calc(100% - 18px); border-top: 2px dashed var(--pebble); }
  .pp-trail li.done + li::before { border-top: 2px solid var(--sea); }
  .pp-trail span { width: 14px; height: 14px; border-radius: 50%; border: 2px solid var(--ink-2); background: var(--paper); }
  .pp-trail .done span { background: var(--sea); border-color: var(--sea); }
  .pp-trail .now span { background: var(--ink); border-color: var(--ink); }
  .pp-trail small { font-size: 0.68rem; color: var(--ink-2); }
  .pp-quote { font-family: var(--f-hand); font-variation-settings: var(--infm-note); color: var(--sea); font-size: 1.1rem; max-width: 26ch; }
  .pp-stamp { position: absolute; right: 24px; bottom: 22px; width: 120px; color: var(--sea); }
  @media (max-width: 560px) { .pp-stamp { position: static; width: 96px; justify-self: end; margin-top: -8px; } }
  .tile { padding: 24px; display: grid; gap: 8px; align-content: start; min-height: 180px; }
  .tile .muted { font-size: 0.95rem; line-height: 1.35; }

  /* split sections: words on one side, a scene on the other */
  .split { display: grid; gap: 32px 64px; align-items: center; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 900px) { .split { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } }
  .split-text { display: grid; gap: 14px; align-content: center; }
  .split-art { width: 100%; max-width: 560px; justify-self: center; }
  @media (max-width: 899px) { .flip .split-art { order: 1; } }
  .cards { margin-top: 32px; display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); }

  /* team */
  .team { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  .team li { display: grid; grid-template-columns: 26px minmax(0, 1fr); gap: 14px; align-items: start; line-height: 1.4; }
  .team .who { font-family: var(--f-hand); font-variation-settings: var(--infm-note); color: var(--sea); }
  .team .muted { font-size: var(--t-small); }
  .voice { font-family: var(--f-hand); font-variation-settings: var(--infm-note); color: var(--sea); font-size: 1.25rem; max-width: 30ch; }
  .guides { margin-top: 40px; padding: 26px 30px; display: grid; gap: 16px 40px; align-items: center; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 900px) { .guides { grid-template-columns: auto minmax(0, 1fr) auto; } }
  .perks { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 12px 28px; }
  .perks li { display: flex; gap: 10px; align-items: center; font-weight: 600; }

  /* partners */
  .ways { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .ways li { display: grid; gap: 14px; align-content: start; padding: 24px; min-height: 140px; }
  @media (max-width: 440px) { .ways { grid-template-columns: minmax(0, 1fr); } .ways li { min-height: 0; } }

  /* closing band */
  .close { margin-top: clamp(110px, 12vw, 170px); background: var(--band); color: var(--on-band); }
  .close .split { padding-block: clamp(64px, 8vw, 110px); }
  .close .label { color: var(--on-band); opacity: 0.8; }
  .close h2 { font-size: var(--t-h1); line-height: 1.02; }
  .note { font-size: 1.15rem; max-width: 32em; opacity: 0.9; }
  .signature { font-family: var(--f-hand); font-variation-settings: var(--infm-note); font-size: 1.4rem; font-weight: 600; }
  .close .split-art :global(.scene) { color: var(--on-band); fill: var(--band); }
  :global(:root) { --footer-gap: 0px; }
</style>
